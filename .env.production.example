# Copy to /opt/clouds/.env, chmod 600, and replace every placeholder locally.
# This file is documentation only; it must not be used unchanged.
COMPOSE_PROJECT_NAME=cloudscommunity
GHCR_REPOSITORY=fabricioalffpagani-spec/cloudscommunity
IMAGE_TAG=sha-REPLACE_WITH_FULL_COMMIT_SHA
PGX_ADMIN_USER=clouds
PGX_ADMIN_PASS=REPLACE_WITH_STRONG_PASSWORD
PGX_DB_NAME=clouds
# URL-encode the password in this URL (do not change POSTGRES_PASSWORD encoding).
PGX_CONN_STR=postgresql://clouds:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/clouds?schema=public
APP_WEB_ORIGIN=https://app.example.com
# Optional: only when trusted sibling subdomains must share the session cookie.
# Leave empty when /socket.io is proxied through the frontend's origin.
SESSION_COOKIE_DOMAIN=
APP_HTTP_PORT=3001
UI_HTTP_PORT=3000
RESEND_API_KEY=
RESEND_FROM_EMAIL=Clouds <no-reply@example.com>
PASSWORD_RESET_EXPIRES_MINUTES=30
