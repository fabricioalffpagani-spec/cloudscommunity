generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  pending
  blocked
}

enum CloudMode {
  text
  audio
}

enum CloudVisibility {
  public
  private
}

enum CloudStatus {
  active
  ended
  archived
  deleted
}

enum MessageType {
  text
  audio
  image
  link
  system
}

enum CloudMemberRole {
  host
  moderator
  member
}

enum NotificationType {
  cloud_activity
  cloud_comment
  cloud_mention
  cloud_hype
  cloud_member_joined
  cloud_member_left
  cloud_message_pinned
  cloud_recommendation
  cloud_trending
  direct_message
  follow
  follow_request
  system
  cloud_continuation
}

enum NotificationEntityType {
  cloud
  cloud_message
  cloud_member
  conversation
  direct_message
  follow
  user
}

model User {
  id            String      @id @default(uuid()) @db.Uuid
  email         String      @unique @db.VarChar(255)
  passwordHash  String      @db.Text
  status        UserStatus  @default(active)
  emailVerifiedAt DateTime?
  termsAcceptedAt DateTime?
  communityRulesAcceptedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  profile                  Profile?
  authoredClouds            Cloud[]         @relation("CloudAuthor")
  cloudHypes                CloudHype[]
  cloudShares               CloudShare[]
  following                 Follow[]        @relation("FollowFollower")
  followers                 Follow[]        @relation("FollowFollowing")
  followRequestsSent        FollowRequest[] @relation("FollowRequestRequester")
  followRequestsReceived    FollowRequest[] @relation("FollowRequestTarget")
  cloudMessages             CloudMessage[]
  directMessages            DirectMessage[]
  directMessageReactions    DirectMessageReaction[]
  participantOneConversations Conversation[] @relation("ConversationParticipantOne")
  participantTwoConversations Conversation[] @relation("ConversationParticipantTwo")
  cloudMembers              CloudMember[]
  conversationMembers       ConversationMember[]
  notifications             Notification[]
  pushSubscriptions         PushSubscription[]
  mediaAssets               MediaAsset[]
  sessions                  Session[]
  emailVerificationTokens   EmailVerificationToken[]
  passwordResetTokens       PasswordResetToken[]
  cloudMessageReactions     CloudMessageReaction[]
  cloudMessageViews         CloudMessageView[]
  cloudBans                 CloudBan[]             @relation("CloudBanUser")
  cloudBansGiven            CloudBan[]             @relation("CloudBanBannedBy")
  cloudReports              CloudReport[]          @relation("CloudReportReported")
  cloudReportsGiven         CloudReport[]          @relation("CloudReportReporter")
  sharePopup                SharePopup?
  blockedUsers              UserBlock[]     @relation("UserBlockBlocker")
  blockedByUsers            UserBlock[]     @relation("UserBlockBlocked")
  savedStickers             SavedSticker[]
  searchHistory             SearchHistory[]

  @@index([status])
  @@index([createdAt])
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.VarChar(128)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.VarChar(128)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Profile {
  userId      String   @id @db.Uuid
  username    String   @unique @db.VarChar(50)
  displayName String   @db.VarChar(120)
  birthDate   DateTime @db.Date
  bio         String?  @db.VarChar(500)
  avatarUrl   String?  @db.Text
  coverUrl    String?  @db.Text
  location    String?  @db.VarChar(120)
  website     String?  @db.VarChar(255)
  isPrivate   Boolean  @default(false)
  showHypesCount Boolean @default(true)
  showArchivedClouds Boolean @default(true)
  showParticipatingNow Boolean @default(true)
  interests     String[] @default([]) @db.Text
  interestsCompletedAt DateTime?
  interestsOnboardingRequired Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts    Contact[]

  @@index([displayName])
}

model Cloud {
  id           String          @id @default(uuid()) @db.Uuid
  authorId     String          @db.Uuid
  title        String          @db.VarChar(180)
  content      String?         @db.Text
  category     String          @db.VarChar(50)
  mode         CloudMode       @default(text)
  visibility   CloudVisibility @default(public)
  status       CloudStatus     @default(active)
  duration     String          @db.VarChar(20)
  editCount    Int             @default(0)
  audioUrl     String?         @db.Text
  scheduledAt  DateTime?
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  originCloudId String?        @db.Uuid
  primaryTopic String?         @db.VarChar(50)
  topicScores  Json?           @db.JsonB
  topicKeywords String[]       @default([]) @db.Text
  topicConfidence Float?
  classificationVersion String? @db.VarChar(20)
  classifiedAt DateTime?

  author       User            @relation("CloudAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  hypes        CloudHype[]
  shares       CloudShare[]
  messages     CloudMessage[]
  members      CloudMember[]
  invites      CloudInvite[]
  bans         CloudBan[]
  reports      CloudReport[]
  originCloud  Cloud?          @relation("CloudContinuations", fields: [originCloudId], references: [id], onDelete: SetNull)
  continuations Cloud[]        @relation("CloudContinuations")

  @@index([authorId, createdAt])
  @@index([category])
  @@index([status])
  @@index([createdAt])
  @@index([originCloudId])
  @@index([primaryTopic])
}

model CloudHype {
  cloudId    String   @db.Uuid
  userId     String   @db.Uuid
  createdAt  DateTime @default(now())

  cloud      Cloud    @relation(fields: [cloudId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cloudId, userId])
  @@index([userId])
}

model CloudShare {
  cloudId    String   @db.Uuid
  userId     String   @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cloud      Cloud    @relation(fields: [cloudId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cloudId, userId])
  @@index([userId])
}

model Follow {
  followerId String   @db.Uuid
  followingId String   @db.Uuid
  createdAt   DateTime @default(now())

  follower   User @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following  User @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model UserBlock {
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())

  blocker User @relation("UserBlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model FollowRequest {
  requesterId String   @db.Uuid
  targetId    String   @db.Uuid
  createdAt   DateTime @default(now())

  requester User @relation("FollowRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  target    User @relation("FollowRequestTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([requesterId, targetId])
  @@index([requesterId])
  @@index([targetId])
}

model CloudMessage {
  id               String       @id @default(uuid()) @db.Uuid
  cloudId          String       @db.Uuid
  userId           String       @db.Uuid
  type             MessageType  @default(text)
  content          String?      @db.Text
  mentions         Json         @default("[]") @db.JsonB
  mediaUrl         String?      @db.Text
  isSticker        Boolean      @default(false)
  replyToMessageId String?      @db.Uuid
  isPinned         Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  cloud            Cloud        @relation(fields: [cloudId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  replyToMessage   CloudMessage?  @relation("CloudMessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          CloudMessage[] @relation("CloudMessageReplies")
  reactions        CloudMessageReaction[]
  views            CloudMessageView[]

  @@index([cloudId, createdAt])
  @@index([userId])
  @@index([replyToMessageId])
  @@index([cloudId, isPinned])
}

model CloudMessageView {
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  viewedAt  DateTime @default(now())

  message   CloudMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId, viewedAt])
}

model SavedSticker {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  mediaUrl    String   @db.Text
  contentHash String   @db.VarChar(32)
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, lastUsedAt(sort: Desc), createdAt(sort: Desc)])
  @@unique([userId, contentHash])
}

// Global, platform-owned catalogue used by both CloudChat and private messages.
// It deliberately has no user foreign key: a sticker remains available even if
// the account that originally suggested it is later removed.
model SystemSticker {
  id          String   @id @default(uuid()) @db.Uuid
  mediaUrl    String   @db.Text
  contentHash String   @unique @db.VarChar(32)
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model SearchHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  query     String   @db.VarChar(120)
  kind      String   @default("query") @db.VarChar(20)
  targetId  String?  @db.VarChar(255)
  subtitle  String?  @db.VarChar(255)
  avatarUrl String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, targetId])
  @@index([userId, updatedAt])
}

model Conversation {
  id                      String   @id @default(uuid()) @db.Uuid
  conversationKey         String   @unique @db.VarChar(100)
  participantOneId        String   @db.Uuid
  participantTwoId        String   @db.Uuid
  lastMessageId           String?  @unique @db.Uuid
  lastMessageType         MessageType?
  lastMessageAt           DateTime?
  lastMessagePreview      String?  @db.VarChar(255)
  participantOneLastReadAt DateTime?
  participantTwoLastReadAt DateTime?
  participantOneUnreadCount Int     @default(0)
  participantTwoUnreadCount Int     @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  deletedAt               DateTime?

  participantOne          User          @relation("ConversationParticipantOne", fields: [participantOneId], references: [id], onDelete: Cascade)
  participantTwo          User          @relation("ConversationParticipantTwo", fields: [participantTwoId], references: [id], onDelete: Cascade)
  lastMessage             DirectMessage? @relation("ConversationLastMessage", fields: [lastMessageId], references: [id], onDelete: SetNull)
  messages                DirectMessage[]
  members                 ConversationMember[]

  @@index([participantOneId])
  @@index([participantTwoId])
  @@index([lastMessageAt])
}

model CloudMember {
  id          String           @id @default(uuid()) @db.Uuid
  cloudId     String           @db.Uuid
  userId      String           @db.Uuid
  role        CloudMemberRole  @default(member)
  joinedAt    DateTime         @default(now())
  leftAt      DateTime?

  cloud       Cloud            @relation(fields: [cloudId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cloudId, userId])
  @@index([userId])
  @@index([cloudId, role])
  @@index([leftAt])
}

model CloudMessageReaction {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  emoji     String   @db.VarChar(50)
  createdAt DateTime @default(now())

  message   CloudMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

model CloudInvite {
  id        String   @id @default(uuid()) @db.Uuid
  cloudId   String   @db.Uuid
  token     String   @unique @db.VarChar(64)
  createdAt DateTime @default(now())
  expiresAt DateTime?

  cloud     Cloud    @relation(fields: [cloudId], references: [id], onDelete: Cascade)

  @@index([cloudId])
  @@index([token])
}

model CloudBan {
  id         String   @id @default(uuid()) @db.Uuid
  cloudId    String   @db.Uuid
  userId     String   @db.Uuid
  bannedById String   @db.Uuid
  createdAt  DateTime @default(now())

  cloud      Cloud    @relation(fields: [cloudId], references: [id], onDelete: Cascade)
  user       User     @relation("CloudBanUser", fields: [userId], references: [id], onDelete: Cascade)
  bannedBy   User     @relation("CloudBanBannedBy", fields: [bannedById], references: [id], onDelete: Cascade)

  @@unique([cloudId, userId])
  @@index([cloudId])
  @@index([userId])
}

model CloudReport {
  id           String   @id @default(uuid()) @db.Uuid
  cloudId      String   @db.Uuid
  reportedId   String   @db.Uuid
  reporterId   String   @db.Uuid
  messageId    String?  @db.Uuid
  reasons      String[] @db.Text
  createdAt    DateTime @default(now())

  cloud        Cloud    @relation(fields: [cloudId], references: [id], onDelete: Cascade)
  reported     User     @relation("CloudReportReported", fields: [reportedId], references: [id], onDelete: Cascade)
  reporter     User     @relation("CloudReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([cloudId, reportedId])
  @@index([reporterId])
}

model ConversationMember {
  id              String       @id @default(uuid()) @db.Uuid
  conversationId  String       @db.Uuid
  userId          String       @db.Uuid
  joinedAt        DateTime     @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId, joinedAt])
}

model Notification {
  id           String                 @id @default(uuid()) @db.Uuid
  userId       String                 @db.Uuid
  type         NotificationType
  entityType   NotificationEntityType
  entityId     String                 @db.VarChar(255)
  title        String                 @db.VarChar(180)
  body         String                 @db.Text
  metadata     Json?                  @db.JsonB
  isRead       Boolean                @default(false)
  createdAt    DateTime               @default(now())

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([entityType, entityId])
  @@index([type])
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CloudPremiereDelivery {
  id        String   @id @default(uuid()) @db.Uuid
  cloudId   String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  @@unique([cloudId, userId])
  @@index([userId, createdAt])
}

model InvitationCode {
  userId     String  @id @db.Uuid
  code       String  @unique @db.VarChar(7)
  legacyCode String? @unique @db.VarChar(7)
}

model InvitationReferral {
  invitedUserId String   @id @db.Uuid
  inviterUserId String   @db.Uuid
  creditedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([inviterUserId, creditedAt])
}

model CloudEndingDelivery {
  id        String   @id @default(uuid()) @db.Uuid
  cloudId   String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  @@unique([cloudId, userId])
  @@index([userId, createdAt])
}

model CloudInterestRecommendationDelivery {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  cloudId   String   @db.Uuid
  slotKey   String   @db.VarChar(32)
  createdAt DateTime @default(now())

  @@unique([userId, slotKey])
  @@unique([userId, cloudId])
  @@index([userId, createdAt])
}

model CloudTrendingDelivery {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  cloudId   String   @db.Uuid
  createdAt DateTime @default(now())

  @@unique([userId, cloudId])
  @@index([userId, createdAt])
}

model MediaAsset {
  id              String   @id @default(uuid()) @db.Uuid
  ownerId         String   @db.Uuid
  url             String   @db.Text
  mimeType        String   @db.VarChar(120)
  sizeBytes       BigInt   @db.BigInt
  storageKey      String   @unique @db.VarChar(255)
  originalFileName String?  @db.VarChar(255)
  width           Int?
  height          Int?
  durationMs      Int?
  createdAt       DateTime @default(now())

  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  directMessages  DirectMessage[]

  @@index([ownerId, createdAt])
  @@index([mimeType])
}

model DirectMessage {
  id               String         @id @default(uuid()) @db.Uuid
  conversationId   String         @db.Uuid
  senderId         String         @db.Uuid
  type             MessageType    @default(text)
  content          String?        @db.Text
  mediaAssetId     String?        @db.Uuid
  clientMessageId  String?        @db.VarChar(80)
  replyToMessageId String?        @db.Uuid
  readAt           DateTime?
  editedAt         DateTime?
  isPinned         Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  conversation     Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender           User           @relation(fields: [senderId], references: [id], onDelete: Cascade)
  mediaAsset       MediaAsset?    @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  replyToMessage   DirectMessage? @relation("DirectMessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          DirectMessage[] @relation("DirectMessageReplies")
  reactions        DirectMessageReaction[]
  lastMessageOfConversation Conversation? @relation("ConversationLastMessage")

  @@index([conversationId, createdAt])
  @@index([conversationId, isPinned])
  @@index([senderId])
  @@index([replyToMessageId])
  @@index([mediaAssetId])
  @@unique([conversationId, clientMessageId])
}

model DirectMessageReaction {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  emoji     String   @db.VarChar(32)
  createdAt DateTime @default(now())

  message DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId, createdAt])
  @@index([userId])
}

model Session {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  refreshTokenHash String  @db.Text
  deviceName      String?  @db.VarChar(120)
  ipAddress       String?  @db.VarChar(45)
  userAgent       String?  @db.Text
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Contact {
  id          String   @id @default(uuid()) @db.Uuid
  profileId   String   @db.Uuid
  name        String   @db.VarChar(120)
  email       String?  @db.VarChar(255)
  phone       String?  @db.VarChar(20)
  invited     Boolean  @default(false)
  invitedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile     Profile  @relation(fields: [profileId], references: [userId], onDelete: Cascade)

  @@index([profileId])
  @@index([email])
  @@index([phone])
}

model SharePopup {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  firstShownAt    DateTime @default(now())
  lastShownAt     DateTime?
  shownCount      Int      @default(1)
  dismissedCount  Int      @default(0)
  sentCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
}
