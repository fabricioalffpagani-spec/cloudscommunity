# PostgreSQL credential bundle for local Prisma CLI and backend runtime.
# Replace these with your local PostgreSQL user and password in backend/.env.
PGX_ADMIN_USER=postgres
PGX_ADMIN_PASS=your_local_password
PGX_DB_NAME=clouds

# Prisma datasource string consumed by the backend.
PGX_CONN_STR=postgresql://postgres:your_local_password@postgres:5432/clouds?schema=public

# Redis endpoint for Socket.IO Pub/Sub and presence. Sessions live in PostgreSQL.
CACHE_NODE_ENDPOINT=redis://redis:6379

# Backend HTTP port inside the Docker network and on the host.
APP_HTTP_PORT=3001

# Allowed browser origin for local CORS.
APP_WEB_ORIGIN=http://localhost:3000
# Set true only when the backend is behind a trusted reverse proxy.
TRUST_PROXY=false

# Resend transactional email configuration.
RESEND_API_KEY=re_replace_with_your_resend_key
RESEND_FROM_EMAIL=Clouds <no-reply@example.com>
# Web Push (gere com: npx web-push generate-vapid-keys; não publique a chave privada)
VAPID_SUBJECT=mailto:suporte@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
SESSION_COOKIE_DOMAIN=
PASSWORD_RESET_EXPIRES_MINUTES=30
