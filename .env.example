# PostgreSQL credentials used by the official postgres container.
# Replace these with your local PostgreSQL user and password in .env.
PGX_ADMIN_USER=postgres
PGX_ADMIN_PASS=your_local_password
PGX_DB_NAME=clouds

# Prisma datasource string consumed by the Nest backend.
PGX_CONN_STR=postgresql://postgres:your_local_password@postgres:5432/clouds?schema=public

# Redis endpoint for Socket.IO Pub/Sub and presence. Sessions live in PostgreSQL.
CACHE_NODE_ENDPOINT=redis://redis:6379

# Backend HTTP port inside the Docker network and on the host.
APP_HTTP_PORT=3001

# Frontend HTTP port inside the Docker network and on the host.
UI_HTTP_PORT=3000

# Allowed browser origin for local CORS. Keep it server-side; the current UI does not need a client-exposed URL env.
APP_WEB_ORIGIN=http://localhost:3000

# Public address used in invitations shared outside the platform. Set this to
# the deployed domain before sharing invitations with other devices.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side BFF target used by the Next.js frontend to reach the Nest API.
CLOUDS_BRIDGE_URL=http://backend:3001

# Public socket URL used by the browser to connect to Socket.IO.
NEXT_PUBLIC_CLOUDS_SOCKET_URL=http://localhost:3001

# Optional development isolation: defaults preserve the usual local names/ports.
# COMPOSE_PROJECT_NAME=cloudscommunity
# DEV_POSTGRES_CONTAINER_NAME=clouds-postgres
# DEV_REDIS_CONTAINER_NAME=clouds-redis
# DEV_BACKEND_CONTAINER_NAME=clouds-backend
# DEV_FRONTEND_CONTAINER_NAME=clouds-frontend
# DEV_POSTGRES_PORT=5433
# DEV_REDIS_PORT=6379
